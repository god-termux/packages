BUILD_ENV="RUSTFLAGS=--cfg=tokio_unstable"
BINS=cosmic-launcher
JUST_INSTALL=1
HOST_DEPS="clang libclang-dev"
ARM64_DEPS="libwayland-dev libxkbcommon-dev libinput-dev libudev-dev libgbm-dev libegl-dev libdrm-dev libfontconfig-dev libfreetype-dev libglvnd-dev libgles-dev libexpat1-dev libffi-dev libdbus-1-dev libxcb1-dev libpixman-1-dev libseat-dev"
PKG=god-cosmic-launcher
DESC="COSMIC application launcher for god-termux"
