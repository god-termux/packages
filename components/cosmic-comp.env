# Композитор COSMIC (Smithay). На Android нет DRM/KMS, поэтому запускается вложенно: COSMIC_BACKEND=winit внутри Wayland-композитора god-termux.
REPO=https://github.com/pop-os/cosmic-comp
REF=0681eaf68324d2afd8cac175d1e10a22b7d34cdf
# без systemd/logind: на телефоне их нет
CARGO_ARGS="--no-default-features"
BINS=cosmic-comp
# пакеты хоста (запускают сборку и bindgen)
HOST_DEPS="clang libclang-dev"
# dev-пакеты arm64: компонуем против библиотек Debian 13 (trixie), как в дереве dapt на телефоне
ARM64_DEPS="libwayland-dev libxkbcommon-dev libinput-dev libudev-dev libseat-dev libgbm-dev libegl-dev libdrm-dev libpixman-1-dev libdisplay-info-dev libfontconfig-dev libfreetype-dev libglvnd-dev libgles-dev libexpat1-dev libffi-dev libevdev-dev libmtdev-dev libgudev-1.0-dev libxcb1-dev libdbus-1-dev"
PKG=god-cosmic
DESC="COSMIC compositor for god-termux (nested in the Wayland window)"
