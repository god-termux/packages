# Экранные уведомления COSMIC (громкость, яркость, polkit)
REPO=https://github.com/pop-os/cosmic-osd
REF=552753febb27baa2f54c6098033d4bd60a7473ed
CARGO_ARGS=""
BUILD_ENV="POLKIT_AGENT_HELPER_1=/usr/lib/polkit-1/polkit-agent-helper-1"
BINS=cosmic-osd
JUST_INSTALL=1
HOST_DEPS="clang libclang-dev"
ARM64_DEPS="libwayland-dev libxkbcommon-dev libinput-dev libudev-dev libgbm-dev libegl-dev libdrm-dev libfontconfig-dev libfreetype-dev libglvnd-dev libgles-dev libexpat1-dev libffi-dev libdbus-1-dev libxcb1-dev libpixman-1-dev libseat-dev libpulse-dev"
PKG=god-cosmic-osd
DESC="COSMIC on-screen display for god-termux"
