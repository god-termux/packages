#!/data/data/com.termux/files/usr/bin/bash
# god-cosmic: композитор COSMIC (cosmic-comp) внутри Wayland-окна god-termux.
#
#   god-cosmic [start] [--desktop] [--native] [--log LEVEL]   (--native: композитор в приложении, мод cosmic)
#                                      запустить COSMIC (окно Wayland откроется само); --desktop (или GOD_COSMIC_DESKTOP=1)
#                                      дополнительно запускает settings-daemon, bg, panel и osd, если они установлены
#                                      (apt: god-cosmic-desktop)
#   god-cosmic run КОМАНДА [АРГУМЕНТЫ]  запустить Wayland-программу внутри COSMIC
#   god-cosmic status                  запущен ли COSMIC и какой у него сокет
#   god-cosmic stop                    остановить COSMIC
#
# На Android нет DRM/KMS, поэтому cosmic-comp работает вложенно (бэкенд winit) в композиторе god-termux (wlcomp).
# Параметры окна (разрешение, частота кадров, режим касаний, клавиатура) задаются в приложении: Настройки Wayland.
set -u
P=${PREFIX:-/data/data/com.termux/files/usr}
D=${DAPT_ROOT:-$P/debian}
RT=$P/tmp
STATE=$RT/god-cosmic.display          # имя сокета Wayland, который открыл cosmic-comp
BIN=$D/usr/bin/cosmic-comp

die() { echo "god-cosmic: $*" >&2; exit 1; }
[ -x "$BIN" ] || die "не найден $BIN (пакет god-cosmic установлен в $D?)"

DBUSF=$RT/god-cosmic.dbus             # "адрес pid" сеансовой шины D-Bus, которую запустил god-cosmic
PIDF=$RT/god-cosmic.pids              # процессы рабочего стола (panel, bg, ...)

# сеансовая шина D-Bus: на Android её нет, а panel, applets и settings-daemon без неё не работают
ensure_dbus() {
  if [ -f "$DBUSF" ]; then
    read -r addr pid <"$DBUSF"
    [ -n "${pid:-}" ] && [ -d "/proc/$pid" ] && { export DBUS_SESSION_BUS_ADDRESS=$addr; return 0; }
  fi
  [ -x "$D/usr/bin/dbus-daemon" ] || { echo "god-cosmic: нет dbus-daemon (dapt install dbus)" >&2; return 1; }
  # адрес фиксирован ($RT/bus): композитор в приложении (мод cosmic) не получает переменных окружения и ищет шину именно там
  rm -f "$RT/bus"
  out=$(env FHS_DEBIAN=1 XDG_RUNTIME_DIR=$RT "$D/usr/bin/dbus-daemon" --session --address="unix:path=$RT/bus" --fork --print-address --print-pid 2>/dev/null) || return 1
  addr=$(printf '%s\n' "$out" | sed -n 1p); pid=$(printf '%s\n' "$out" | sed -n 2p)
  [ -n "$addr" ] || return 1
  echo "$addr $pid" >"$DBUSF"; export DBUS_SESSION_BUS_ADDRESS=$addr
}

cosmic_env() {
  ensure_dbus || true
  export FHS_DEBIAN=1 COSMIC_BACKEND=winit XDG_RUNTIME_DIR=$RT NO_AT_BRIDGE=1
  # «системная» шина (UPower, NetworkManager от моста Android) и звук (PulseAudio для Android)
  export DBUS_SYSTEM_BUS_ADDRESS=unix:path=$RT/system_bus
  # приложения ходят в pipewire-pulse (тогда слайдер громкости в панели управляет звуком); иначе прямо в PulseAudio Android
  if [ -S "$RT/pulse/native" ]; then export PULSE_SERVER=unix:$RT/pulse/native; else export PULSE_SERVER=unix:$RT/pulse-native; fi
  export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
  export XDG_DATA_DIRS=$D/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}
  # libxkbcommon проверяет каталог раскладок через eaccess(); шим god-termux до исправления его не переводил
  [ -d "$D/usr/share/X11/xkb" ] && export XKB_CONFIG_ROOT=$D/usr/share/X11/xkb
}

pids() { for p in /proc/[0-9]*; do
  c=$({ tr '\0' ' ' <"$p/cmdline"; } 2>/dev/null) || continue
  case "$c" in */cosmic-comp*) case "$c" in *god-cosmic*) ;; *) echo "${p#/proc/}";; esac;; esac
done; }

new_socket() { # печатает имя сокета, появившегося или пересозданного после запуска ($MARK)
  for i in $(seq 1 60); do
    for s in "$RT"/wayland-[0-9]*; do
      case "$s" in *.lock) continue;; esac
      # старый сокет с тем же именем (остался от прошлого запуска) comp переиспользует: сравниваем по времени
      [ -S "$s" ] && [ "$s" -nt "$MARK" ] && { echo "${s##*/}"; return 0; }
    done
    sleep 0.5
  done
  return 1
}

desktop_procs() { # все процессы COSMIC из дерева Debian, кроме композитора и самого лаунчера
  for p in /proc/[0-9]*; do
    c=$({ tr '\0' ' ' <"$p/cmdline"; } 2>/dev/null) || continue
    case "$c" in *"$D"/usr/bin/cosmic-comp*) continue;; *"$D"/usr/bin/cosmic-*) echo "${p#/proc/}";; esac
  done
}

stop_desktop() {
  [ -f "$PIDF" ] && { while read -r p; do kill "$p" 2>/dev/null; done <"$PIDF"; rm -f "$PIDF"; }
  # shellcheck disable=SC2046
  kill $(desktop_procs) 2>/dev/null
  sleep 1
  # зависшие (settings-daemon в цикле перезапуска pipewire не реагирует на TERM)
  # shellcheck disable=SC2046
  kill -9 $(desktop_procs) 2>/dev/null
  if [ -f "$DBUSF" ]; then read -r _ pid <"$DBUSF"; [ -n "${pid:-}" ] && kill "$pid" 2>/dev/null; rm -f "$DBUSF"; fi
  for p in /proc/[0-9]*; do
    case "$({ tr '\0' ' ' <"$p/cmdline"; } 2>/dev/null)" in *god-cosmic-clipboard*) kill "${p#/proc/}" 2>/dev/null;; esac
  done
  stop_services
}

# --- службы Android для COSMIC: системная шина + мост (UPower/NetworkManager из данных мода xfcestatus) и звук ---
SYSBUSPID=$RT/god-cosmic.sysbus; BRIDGEPID=$RT/god-cosmic.bridge
alive_pid() { [ -f "$1" ] && read -r _p <"$1" && [ -n "${_p:-}" ] && [ -d "/proc/$_p" ]; }

start_services() {
  # системная шина для апплетов: обычный dbus-daemon на сокете $RT/system_bus (DBUS_SYSTEM_BUS_ADDRESS)
  if ! alive_pid "$SYSBUSPID" && [ -x "$D/usr/bin/dbus-daemon" ]; then
    rm -f "$RT/system_bus"
    env FHS_DEBIAN=1 XDG_RUNTIME_DIR=$RT "$D/usr/bin/dbus-daemon" --session --address="unix:path=$RT/system_bus" --fork --print-pid >"$SYSBUSPID" 2>/dev/null || rm -f "$SYSBUSPID"
  fi
  # мост Android -> COSMIC (бинарь ставится вместе с модом cosmic)
  br=$(command -v god-android-bridge || true); [ -x "$br" ] || br=$HOME/.termux/mods/cosmic/bin/god-android-bridge
  if [ -x "$br" ] && ! alive_pid "$BRIDGEPID" && alive_pid "$SYSBUSPID"; then
    DBUS_SYSTEM_BUS_ADDRESS=unix:path=$RT/system_bus setsid -f "$br" >>"$RT/god-cosmic-bridge.log" 2>&1 </dev/null
    sleep 1; pid=$(ps -A -o pid,args 2>/dev/null | awk '$2 ~ /god-android-bridge$/ {print $1; exit}'); [ -n "$pid" ] && echo "$pid" >"$BRIDGEPID"
  fi
  # звук: PulseAudio из Termux (OpenSL ES), сокет $RT/pulse-native
  if command -v pulseaudio >/dev/null && ! PULSE_SERVER=unix:$RT/pulse-native timeout 3 pactl info >/dev/null 2>&1; then
    rm -f "$RT/pulse-native"
    env -u PULSE_SERVER pulseaudio --start --exit-idle-time=-1 --daemonize=yes --load="module-sles-sink" \
      --load="module-native-protocol-unix auth-anonymous=1 socket=$RT/pulse-native" >>"$RT/god-cosmic-pulse.log" 2>&1 || true
  fi
  # ждём, пока PulseAudio Android начнёт принимать подключения (иначе туннель PipeWire получит Connection refused)
  for _i in $(seq 1 30); do PULSE_SERVER=unix:$RT/pulse-native timeout 2 pactl info >/dev/null 2>&1 && break; sleep 0.5; done
  start_audio
  # cosmic_env мог выбрать PULSE_SERVER до запуска pipewire-pulse: обновляем
  if [ -S "$RT/pulse/native" ]; then export PULSE_SERVER=unix:$RT/pulse/native; fi
}

# --- звук COSMIC: PipeWire (Debian) с туннельным выходом в PulseAudio Android + WirePlumber + pipewire-pulse ---
# Цепочка: приложение -> pipewire-pulse / PipeWire -> pulse-tunnel -> PulseAudio Termux (OpenSL ES) -> динамики/наушники Android.
# Нужны Debian-пакеты pipewire, pipewire-bin, wireplumber, pipewire-pulse (dapt install god-cosmic-desktop тянет их).
# pid процесса из Debian-дерева по имени программы: их comm — загрузчик (ld-linux), поэтому ищем по пути в конце командной строки
gpid() { ps -A -o pid,args 2>/dev/null | awk -v n="$D/usr/bin/$1" '$NF == n {print $1}' | head -1; }

start_audio() {
  command -v pulseaudio >/dev/null || return 0
  for b in pipewire wireplumber pipewire-pulse; do [ -x "$D/usr/bin/$b" ] || return 0; done
  L=$D/usr/lib/aarch64-linux-gnu
  # libpulse ищет libpulsecommon в подкаталоге pulseaudio/, которого нет в пути поиска glibc-шима: кладём ссылку рядом
  for f in "$L"/pulseaudio/libpulsecommon-*.so; do
    [ -e "$f" ] && [ ! -e "$L/${f##*/}" ] && ln -sf "pulseaudio/${f##*/}" "$L/${f##*/}"
  done
  CFG=$RT/god-audio-cfg
  mkdir -p "$CFG/pipewire/pipewire.conf.d" "$CFG/wireplumber/wireplumber.conf.d"
  cat >"$CFG/pipewire/pipewire.conf.d/10-god.conf" <<EOF
context.properties = { support.dbus = false }
context.modules = [
  { name = libpipewire-module-pulse-tunnel
    args = { tunnel.mode = sink  pulse.server.address = "unix:$RT/pulse-native"  node.name = "android_out"  node.description = "Android audio"
             audio.rate = 44100  audio.channels = 2  audio.position = [ FL FR ] } }
]
EOF
  cat >"$CFG/wireplumber/wireplumber.conf.d/90-god.conf" <<'EOF'
wireplumber.profiles = { main = { monitor.alsa = disabled  monitor.alsa-midi = disabled  monitor.bluez = disabled  monitor.bluez-midi = disabled  monitor.v4l2 = disabled  monitor.libcamera = disabled } }
EOF
  # устаревшие сокет и lock от прошлого запуска мешают PipeWire (Address already in use)
  [ -n "$(gpid pipewire)" ] || rm -f "$RT"/pipewire-0 "$RT"/pipewire-0.lock "$RT"/pipewire-0-manager "$RT"/pipewire-0-manager.lock "$RT"/pulse/native "$RT"/pulse/pid
  AE="env FHS_DEBIAN=1 XDG_RUNTIME_DIR=$RT XDG_CONFIG_HOME=$CFG"
  if ! [ -n "$(gpid pipewire)" ]; then
    $AE setsid -f "$D/usr/bin/pipewire" >>"$RT/god-cosmic-audio.log" 2>&1 </dev/null
    for _i in $(seq 1 30); do [ -S "$RT/pipewire-0" ] && [ -n "$(gpid pipewire)" ] && break; sleep 0.5; done
    sleep 1
  fi
  [ -n "$(gpid pipewire)" ] || { echo "god-cosmic: PipeWire не запустился (см. $RT/god-cosmic-audio.log)" >&2; return 0; }
  for c in wireplumber pipewire-pulse; do
    [ -n "$(gpid "$c")" ] && continue
    $AE setsid -f "$D/usr/bin/$c" >>"$RT/god-cosmic-audio.log" 2>&1 </dev/null
    sleep 3
  done
}

stop_audio() {
  for c in pipewire-pulse wireplumber pipewire; do p=$(gpid "$c"); [ -n "$p" ] && kill $p 2>/dev/null; done
}

stop_services() {
  for f in "$BRIDGEPID" "$SYSBUSPID"; do
    [ -f "$f" ] && { read -r _p <"$f"; [ -n "${_p:-}" ] && kill "$_p" 2>/dev/null; rm -f "$f"; }
  done
  stop_audio
  rm -f "$RT/system_bus"
}

# апплет экранной клавиатуры в панель (если пользователь не настроил панель сам)
ensure_osk_applet() {
  src=$D/usr/share/cosmic/com.system76.CosmicPanel.Panel/v1/plugins_wings
  dst=${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/com.system76.CosmicPanel.Panel/v1/plugins_wings
  [ -f "$src" ] && [ ! -f "$dst" ] && [ -x "$D/usr/bin/cosmic-applet-osk" ] || return 0
  mkdir -p "$(dirname "$dst")"
  sed 's/"com.system76.CosmicAppletInputSources"/"com.system76.CosmicAppletOsk","com.system76.CosmicAppletInputSources"/' "$src" >"$dst"
}

# экранная клавиатура должна показываться сама при фокусе в текстовом поле (по умолчанию в cosmic-osk выключено)
ensure_osk_state() {
  f=${XDG_STATE_HOME:-$HOME/.local/state}/cosmic/com.system76.CosmicOSK/v1/ime_activation
  [ -x "$D/usr/bin/cosmic-osk" ] && [ ! -f "$f" ] || return 0
  mkdir -p "$(dirname "$f")" && printf true >"$f"
}

# Нативный режим: cosmic-comp живёт в приложении (мод cosmic, рисует на GPU), лаунчер только поднимает компоненты стола
# ярлыки приложений: Debian-ярлык chromium.desktop зовёт /usr/bin/chromium (голый glibc-Chromium без флагов Android), он не запускается.
# Если в Termux есть нативный chromium-browser, перекрываем ярлык своим (каталог пользователя приоритетнее XDG_DATA_DIRS)
ensure_app_entries() {
  command -v chromium-browser >/dev/null || return 0
  d=${XDG_DATA_HOME:-$HOME/.local/share}/applications; mkdir -p "$d"
  f=$d/chromium.desktop
  [ -f "$f" ] && grep -q '^X-God-Cosmic=1' "$f" && return 0
  cat >"$f" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Chromium Web Browser
GenericName=Web Browser
Comment=Chromium из Termux (chromium-browser)
Exec=chromium-browser %U
Icon=chromium
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
X-God-Cosmic=1
EOF
}

start_native() {
  command -v cosmic-native >/dev/null || die "нет мода cosmic (god-termux/god-termux, god/mods/cosmic/install.sh)"
  cosmic_env
  # один запуск на сеанс: мод cosmic сам вызывает этот лаунчер при открытии экрана, ручной запуск параллельно давал вторые копии панели и дока
  LOCK=$RT/god-cosmic-native.pid
  app0=$(ps -A -o pid,args 2>/dev/null | awk '$2=="com.termux"{print $1; exit}')
  if [ -s "$LOCK" ]; then
    lp=$(cat "$LOCK")
    if [ "$lp" != "$$" ] && [ -d "/proc/$lp" ] && tr '\0' ' ' <"/proc/$lp/cmdline" 2>/dev/null | grep -q god-cosmic \
       && { [ -z "$app0" ] || [ "$LOCK" -nt "/proc/$app0" ]; }; then
      echo "god-cosmic: уже запущен (pid $lp), второй экземпляр не нужен" >&2; exit 0
    fi
  fi
  echo $$ >"$LOCK"
  ensure_osk_applet; ensure_osk_state; ensure_app_entries; start_services
  # композитор живёт в процессе приложения: файл cosmic-socket актуален, если он новее самого процесса приложения
  app=$(ps -A -o pid,args 2>/dev/null | awk '$2=="com.termux"{print $1; exit}')
  fresh() { [ -s "$RT/cosmic-socket" ] && S=$(cat "$RT/cosmic-socket") && [ -S "$RT/$S" ] && { [ -z "$app" ] || [ "$RT/cosmic-socket" -nt "/proc/$app" ]; }; }
  S=""
  if ! fresh; then
    S=""; rm -f "$RT/cosmic-socket"
  fi
  rm -f "$RT/cosmic-mod.log.old"; [ -f "$RT/cosmic-mod.log" ] && mv "$RT/cosmic-mod.log" "$RT/cosmic-mod.log.old"
  # GOD_COSMIC_NO_OPEN=1: экран уже открыт (так запускает мод cosmic), второй раз его открывать не нужно
  if [ "${GOD_COSMIC_NO_OPEN:-0}" != 1 ]; then
    out=$(cosmic-native 2>&1) || die "не удалось открыть экран COSMIC: $out (мод cosmic загружен? перезапустите Termux)"
    case "$out" in *Error*|*rror:*) die "am start: $out";; esac
  fi
  for i in $(seq 1 120); do
    fresh && break
    S=""; sleep 0.5
  done
  if [ -z "$S" ]; then
    echo "god-cosmic: композитор в приложении не создал сокет за 60 с" >&2
    [ -f "$RT/cosmic-mod.log" ] && { echo "--- $RT/cosmic-mod.log:" >&2; tail -20 "$RT/cosmic-mod.log" >&2; }
    [ -s "$RT/cosmic-comp.log" ] && { echo "--- $RT/cosmic-comp.log (хвост):" >&2; tail -8 "$RT/cosmic-comp.log" >&2; }
    exit 1
  fi
  echo "$S" >"$STATE"; echo "god-cosmic: нативный COSMIC, сокет $S (god-cosmic run КОМАНДА)" >&2
  trap 'stop_desktop; rm -f "$STATE" "$LOCK"; exit 0' INT TERM
  # клиенты, запущенные раньше текущего композитора (остались от прошлого запуска приложения), подключены к мёртвому сокету
  for p in $(desktop_procs); do [ "$RT/cosmic-socket" -nt "/proc/$p" ] && kill "$p" 2>/dev/null; done
  sleep 1
  if [ "$DESKTOP" = 1 ]; then
    if [ -n "$(desktop_procs)" ]; then
      echo "god-cosmic: компоненты стола уже запущены" >&2
    else
      : >"$PIDF"
      for c in cosmic-settings-daemon cosmic-bg cosmic-notifications cosmic-panel cosmic-osd cosmic-osk; do
        [ -x "$D/usr/bin/$c" ] || { echo "god-cosmic: $c не установлен, пропускаю" >&2; continue; }
        # setsid: компоненты не умирают вместе с терминалом, из которого запущен лаунчер
        if command -v setsid >/dev/null; then setsid -f "$0" run "$D/usr/bin/$c" >>"$RT/god-cosmic-$c.log" 2>&1 </dev/null
        else nohup "$0" run "$D/usr/bin/$c" >>"$RT/god-cosmic-$c.log" 2>&1 </dev/null & fi
        sleep 1
      done
      # буфер обмена Android <-> COSMIC
      if [ -x "$D/usr/bin/wl-paste" ] && command -v god-cosmic-clipboard >/dev/null; then
        setsid -f "$0" run "$(command -v god-cosmic-clipboard)" >>"$RT/god-cosmic-clipboard.log" 2>&1 </dev/null
      fi
    fi
  fi
  # пока сокет композитора жив (приложение работает), держим сеанс; затем гасим компоненты
  while [ -S "$RT/$S" ]; do sleep 5; done
  stop_desktop; rm -f "$STATE" "$LOCK"
}

cmd=${1:-start}; [ $# -gt 0 ] && shift
case "$cmd" in
  start)
    LOG=${RUST_LOG:-warn}; DESKTOP=${GOD_COSMIC_DESKTOP:-0}
    NATIVE=0
    while [ $# -gt 0 ]; do case "$1" in --log) LOG=${2:?}; shift 2;; --desktop) DESKTOP=1; shift;; --native) NATIVE=1; shift;; *) die "неизвестный параметр: $1";; esac; done
    if [ "$NATIVE" = 1 ]; then start_native; exit $?; fi
    [ -n "$(pids)" ] && die "COSMIC уже запущен (god-cosmic stop)"
    command -v wlrun >/dev/null || die "нет wlrun (нужен god-termux с модом Wayland)"
    wlrun --open || die "композитор god-termux не запустился"
    cosmic_env; export RUST_LOG=$LOG
    MARK=$RT/god-cosmic.mark; : >"$MARK"; sleep 1
    # wlrun задаёт WAYLAND_DISPLAY внешнего композитора и запускает команду через env
    wlrun "$BIN" &
    CPID=$!
    trap 'kill $CPID 2>/dev/null; stop_desktop; rm -f "$STATE"; exit 0' INT TERM
    if S=$(new_socket); then echo "$S" >"$STATE"; echo "god-cosmic: COSMIC запущен, сокет $S (god-cosmic run КОМАНДА)" >&2
      if [ "$DESKTOP" = 1 ]; then
        : >"$PIDF"
        for c in cosmic-settings-daemon cosmic-bg cosmic-notifications cosmic-panel cosmic-osd cosmic-osk; do
          [ -x "$D/usr/bin/$c" ] || { echo "god-cosmic: $c не установлен, пропускаю" >&2; continue; }
          "$0" run "$D/usr/bin/$c" >>"$RT/god-cosmic-$c.log" 2>&1 & echo $! >>"$PIDF"; sleep 1
        done
        # сторож: лог компонента не должен разрастаться (раньше зациклившийся клиент забил диск)
        ( while kill -0 $CPID 2>/dev/null; do
            for f in "$RT"/god-cosmic-*.log; do
              [ -f "$f" ] && [ "$(stat -c %s "$f" 2>/dev/null || echo 0)" -gt 10485760 ] && : >"$f"
            done; sleep 20; done ) >/dev/null 2>&1 &
        echo $! >>"$PIDF"
      fi
    else echo "god-cosmic: сокет COSMIC не появился, смотрите вывод выше" >&2; fi
    wait $CPID; rc=$?; rm -f "$STATE"; exit $rc ;;
  run)
    [ $# -gt 0 ] || die "usage: god-cosmic run КОМАНДА [АРГУМЕНТЫ]"
    [ -f "$STATE" ] || die "COSMIC не запущен (god-cosmic start)"
    cosmic_env
    prog=$1; shift
    case "$prog" in */*) ;; *) [ -x "$D/usr/bin/$prog" ] && prog=$D/usr/bin/$prog;; esac   # имя программы из дерева Debian
    exec env WAYLAND_DISPLAY="$(cat "$STATE")" GDK_BACKEND=wayland QT_QPA_PLATFORM=wayland MOZ_ENABLE_WAYLAND=1 "$prog" "$@" ;;
  status)
    if [ -n "$(pids)" ] && [ -f "$STATE" ]; then echo "запущен, сокет $(cat "$STATE")"
    elif [ -f "$STATE" ] && [ -S "$RT/$(cat "$STATE")" ]; then echo "запущен (нативный, в приложении), сокет $(cat "$STATE")"
    else echo "не запущен"; exit 1; fi ;;
  stop)
    p=$(pids)
    if [ -z "$p" ]; then
      native=0; [ -f "$STATE" ] && [ -S "$RT/$(cat "$STATE")" ] && native=1
      stop_desktop; rm -f "$STATE"
      if [ "$native" = 1 ]; then echo "компоненты остановлены (композитор живёт в приложении: закройте экран COSMIC)"; else echo "не запущен"; fi
      exit 0
    fi
    # shellcheck disable=SC2086
    kill $p 2>/dev/null; stop_desktop; rm -f "$STATE"; echo "остановлен" ;;
  -h|--help|help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "неизвестная команда: $cmd (help)" ;;
esac
