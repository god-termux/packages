#!/data/data/com.termux/files/usr/bin/bash
# god-cosmic: композитор COSMIC (cosmic-comp) внутри Wayland-окна god-termux.
#
#   god-cosmic [start] [--desktop] [--native] [--log LEVEL]   (--native: композитор в приложении, мод cosmic)
#                                      запустить COSMIC (окно Wayland откроется само); --desktop (или GOD_COSMIC_DESKTOP=1)
#                                      дополнительно запускает settings-daemon, bg, panel и osd, если они установлены
#                                      (apt: god-cosmic-desktop)
#   god-cosmic run КОМАНДА [АРГУМЕНТЫ]  запустить Wayland-программу внутри COSMIC
#   god-cosmic status                  запущен ли COSMIC и какой у него сокет
#   god-cosmic stop                    остановить COSMIC
#
# На Android нет DRM/KMS, поэтому cosmic-comp работает вложенно (бэкенд winit) в композиторе god-termux (wlcomp).
# Параметры окна (разрешение, частота кадров, режим касаний, клавиатура) задаются в приложении: Настройки Wayland.
set -u
P=${PREFIX:-/data/data/com.termux/files/usr}
D=${DAPT_ROOT:-$P/debian}
RT=$P/tmp
STATE=$RT/god-cosmic.display          # имя сокета Wayland, который открыл cosmic-comp
BIN=$D/usr/bin/cosmic-comp

die() { echo "god-cosmic: $*" >&2; exit 1; }
[ -x "$BIN" ] || die "не найден $BIN (пакет god-cosmic установлен в $D?)"

DBUSF=$RT/god-cosmic.dbus             # "адрес pid" сеансовой шины D-Bus, которую запустил god-cosmic
PIDF=$RT/god-cosmic.pids              # процессы рабочего стола (panel, bg, ...)

# сеансовая шина D-Bus: на Android её нет, а panel, applets и settings-daemon без неё не работают
ensure_dbus() {
  if [ -f "$DBUSF" ]; then
    read -r addr pid <"$DBUSF"
    [ -n "${pid:-}" ] && [ -d "/proc/$pid" ] && { export DBUS_SESSION_BUS_ADDRESS=$addr; return 0; }
  fi
  [ -x "$D/usr/bin/dbus-daemon" ] || { echo "god-cosmic: нет dbus-daemon (dapt install dbus)" >&2; return 1; }
  # адрес фиксирован ($RT/bus): композитор в приложении (мод cosmic) не получает переменных окружения и ищет шину именно там
  rm -f "$RT/bus"
  out=$(env FHS_DEBIAN=1 XDG_RUNTIME_DIR=$RT "$D/usr/bin/dbus-daemon" --session --address="unix:path=$RT/bus" --fork --print-address --print-pid 2>/dev/null) || return 1
  addr=$(printf '%s\n' "$out" | sed -n 1p); pid=$(printf '%s\n' "$out" | sed -n 2p)
  [ -n "$addr" ] || return 1
  echo "$addr $pid" >"$DBUSF"; export DBUS_SESSION_BUS_ADDRESS=$addr
}

cosmic_env() {
  ensure_dbus || true
  export FHS_DEBIAN=1 COSMIC_BACKEND=winit XDG_RUNTIME_DIR=$RT NO_AT_BRIDGE=1
  export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
  export XDG_DATA_DIRS=$D/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}
  # libxkbcommon проверяет каталог раскладок через eaccess(); шим god-termux до исправления его не переводил
  [ -d "$D/usr/share/X11/xkb" ] && export XKB_CONFIG_ROOT=$D/usr/share/X11/xkb
}

pids() { for p in /proc/[0-9]*; do
  c=$({ tr '\0' ' ' <"$p/cmdline"; } 2>/dev/null) || continue
  case "$c" in */cosmic-comp*) case "$c" in *god-cosmic*) ;; *) echo "${p#/proc/}";; esac;; esac
done; }

new_socket() { # печатает имя сокета, появившегося или пересозданного после запуска ($MARK)
  for i in $(seq 1 60); do
    for s in "$RT"/wayland-[0-9]*; do
      case "$s" in *.lock) continue;; esac
      # старый сокет с тем же именем (остался от прошлого запуска) comp переиспользует: сравниваем по времени
      [ -S "$s" ] && [ "$s" -nt "$MARK" ] && { echo "${s##*/}"; return 0; }
    done
    sleep 0.5
  done
  return 1
}

desktop_procs() { # все процессы COSMIC из дерева Debian, кроме композитора и самого лаунчера
  for p in /proc/[0-9]*; do
    c=$({ tr '\0' ' ' <"$p/cmdline"; } 2>/dev/null) || continue
    case "$c" in *"$D"/usr/bin/cosmic-comp*) continue;; *"$D"/usr/bin/cosmic-*) echo "${p#/proc/}";; esac
  done
}

stop_desktop() {
  [ -f "$PIDF" ] && { while read -r p; do kill "$p" 2>/dev/null; done <"$PIDF"; rm -f "$PIDF"; }
  # shellcheck disable=SC2046
  kill $(desktop_procs) 2>/dev/null
  sleep 1
  # зависшие (settings-daemon в цикле перезапуска pipewire не реагирует на TERM)
  # shellcheck disable=SC2046
  kill -9 $(desktop_procs) 2>/dev/null
  if [ -f "$DBUSF" ]; then read -r _ pid <"$DBUSF"; [ -n "${pid:-}" ] && kill "$pid" 2>/dev/null; rm -f "$DBUSF"; fi
}

# апплет экранной клавиатуры в панель (если пользователь не настроил панель сам)
ensure_osk_applet() {
  src=$D/usr/share/cosmic/com.system76.CosmicPanel.Panel/v1/plugins_wings
  dst=${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/com.system76.CosmicPanel.Panel/v1/plugins_wings
  [ -f "$src" ] && [ ! -f "$dst" ] && [ -x "$D/usr/bin/cosmic-applet-osk" ] || return 0
  mkdir -p "$(dirname "$dst")"
  sed 's/"com.system76.CosmicAppletInputSources"/"com.system76.CosmicAppletOsk","com.system76.CosmicAppletInputSources"/' "$src" >"$dst"
}

# экранная клавиатура должна показываться сама при фокусе в текстовом поле (по умолчанию в cosmic-osk выключено)
ensure_osk_state() {
  f=${XDG_STATE_HOME:-$HOME/.local/state}/cosmic/com.system76.CosmicOSK/v1/ime_activation
  [ -x "$D/usr/bin/cosmic-osk" ] && [ ! -f "$f" ] || return 0
  mkdir -p "$(dirname "$f")" && printf true >"$f"
}

# Нативный режим: cosmic-comp живёт в приложении (мод cosmic, рисует на GPU), лаунчер только поднимает компоненты стола
start_native() {
  command -v cosmic-native >/dev/null || die "нет мода cosmic (god-termux/god-termux, god/mods/cosmic/install.sh)"
  cosmic_env
  ensure_osk_applet; ensure_osk_state
  rm -f "$RT/cosmic-socket"
  rm -f "$RT/cosmic-mod.log"
  out=$(cosmic-native 2>&1) || die "не удалось открыть экран COSMIC: $out (мод cosmic загружен? перезапустите Termux)"
  case "$out" in *Error*|*rror:*) die "am start: $out";; esac
  S=""
  for i in $(seq 1 120); do
    [ -s "$RT/cosmic-socket" ] && S=$(cat "$RT/cosmic-socket") && [ -S "$RT/$S" ] && break
    S=""; sleep 0.5
  done
  if [ -z "$S" ]; then
    echo "god-cosmic: композитор в приложении не создал сокет за 60 с" >&2
    [ -f "$RT/cosmic-mod.log" ] && { echo "--- $RT/cosmic-mod.log:" >&2; tail -20 "$RT/cosmic-mod.log" >&2; }
    [ -s "$RT/cosmic-comp.log" ] && { echo "--- $RT/cosmic-comp.log (хвост):" >&2; tail -8 "$RT/cosmic-comp.log" >&2; }
    exit 1
  fi
  echo "$S" >"$STATE"; echo "god-cosmic: нативный COSMIC, сокет $S (god-cosmic run КОМАНДА)" >&2
  trap 'stop_desktop; rm -f "$STATE"; exit 0' INT TERM
  if [ "$DESKTOP" = 1 ]; then
    : >"$PIDF"
    for c in cosmic-settings-daemon cosmic-bg cosmic-notifications cosmic-panel cosmic-osd cosmic-osk; do
      [ -x "$D/usr/bin/$c" ] || { echo "god-cosmic: $c не установлен, пропускаю" >&2; continue; }
      "$0" run "$D/usr/bin/$c" >>"$RT/god-cosmic-$c.log" 2>&1 & echo $! >>"$PIDF"; sleep 1
    done
  fi
  # пока сокет композитора жив (приложение работает), держим сеанс; затем гасим компоненты
  while [ -S "$RT/$S" ]; do sleep 5; done
  stop_desktop; rm -f "$STATE"
}

cmd=${1:-start}; [ $# -gt 0 ] && shift
case "$cmd" in
  start)
    LOG=${RUST_LOG:-warn}; DESKTOP=${GOD_COSMIC_DESKTOP:-0}
    NATIVE=0
    while [ $# -gt 0 ]; do case "$1" in --log) LOG=${2:?}; shift 2;; --desktop) DESKTOP=1; shift;; --native) NATIVE=1; shift;; *) die "неизвестный параметр: $1";; esac; done
    if [ "$NATIVE" = 1 ]; then start_native; exit $?; fi
    [ -n "$(pids)" ] && die "COSMIC уже запущен (god-cosmic stop)"
    command -v wlrun >/dev/null || die "нет wlrun (нужен god-termux с модом Wayland)"
    wlrun --open || die "композитор god-termux не запустился"
    cosmic_env; export RUST_LOG=$LOG
    MARK=$RT/god-cosmic.mark; : >"$MARK"; sleep 1
    # wlrun задаёт WAYLAND_DISPLAY внешнего композитора и запускает команду через env
    wlrun "$BIN" &
    CPID=$!
    trap 'kill $CPID 2>/dev/null; stop_desktop; rm -f "$STATE"; exit 0' INT TERM
    if S=$(new_socket); then echo "$S" >"$STATE"; echo "god-cosmic: COSMIC запущен, сокет $S (god-cosmic run КОМАНДА)" >&2
      if [ "$DESKTOP" = 1 ]; then
        : >"$PIDF"
        for c in cosmic-settings-daemon cosmic-bg cosmic-notifications cosmic-panel cosmic-osd cosmic-osk; do
          [ -x "$D/usr/bin/$c" ] || { echo "god-cosmic: $c не установлен, пропускаю" >&2; continue; }
          "$0" run "$D/usr/bin/$c" >>"$RT/god-cosmic-$c.log" 2>&1 & echo $! >>"$PIDF"; sleep 1
        done
        # сторож: лог компонента не должен разрастаться (раньше зациклившийся клиент забил диск)
        ( while kill -0 $CPID 2>/dev/null; do
            for f in "$RT"/god-cosmic-*.log; do
              [ -f "$f" ] && [ "$(stat -c %s "$f" 2>/dev/null || echo 0)" -gt 10485760 ] && : >"$f"
            done; sleep 20; done ) >/dev/null 2>&1 &
        echo $! >>"$PIDF"
      fi
    else echo "god-cosmic: сокет COSMIC не появился, смотрите вывод выше" >&2; fi
    wait $CPID; rc=$?; rm -f "$STATE"; exit $rc ;;
  run)
    [ $# -gt 0 ] || die "usage: god-cosmic run КОМАНДА [АРГУМЕНТЫ]"
    [ -f "$STATE" ] || die "COSMIC не запущен (god-cosmic start)"
    cosmic_env
    prog=$1; shift
    case "$prog" in */*) ;; *) [ -x "$D/usr/bin/$prog" ] && prog=$D/usr/bin/$prog;; esac   # имя программы из дерева Debian
    exec env WAYLAND_DISPLAY="$(cat "$STATE")" GDK_BACKEND=wayland QT_QPA_PLATFORM=wayland MOZ_ENABLE_WAYLAND=1 "$prog" "$@" ;;
  status)
    if [ -n "$(pids)" ] && [ -f "$STATE" ]; then echo "запущен, сокет $(cat "$STATE")"
    elif [ -f "$STATE" ] && [ -S "$RT/$(cat "$STATE")" ]; then echo "запущен (нативный, в приложении), сокет $(cat "$STATE")"
    else echo "не запущен"; exit 1; fi ;;
  stop)
    p=$(pids)
    if [ -z "$p" ]; then
      native=0; [ -f "$STATE" ] && [ -S "$RT/$(cat "$STATE")" ] && native=1
      stop_desktop; rm -f "$STATE"
      if [ "$native" = 1 ]; then echo "компоненты остановлены (композитор живёт в приложении: закройте экран COSMIC)"; else echo "не запущен"; fi
      exit 0
    fi
    # shellcheck disable=SC2086
    kill $p 2>/dev/null; stop_desktop; rm -f "$STATE"; echo "остановлен" ;;
  -h|--help|help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "неизвестная команда: $cmd (help)" ;;
esac
